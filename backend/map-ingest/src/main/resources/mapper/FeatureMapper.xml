<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aomap.ingest.mapper.FeatureMapper">

    <update id="truncateStage">
        TRUNCATE osm_feature_stage
    </update>

    <select id="countStage" resultType="long">
        SELECT COUNT(*) FROM osm_feature_stage
    </select>

    <select id="countFeatures" resultType="long">
        SELECT COUNT(*) FROM osm_feature WHERE region_code = #{regionCode}
    </select>

    <select id="countByLayer" resultType="com.aomap.ingest.domain.LayerCountRow">
        SELECT layer, COUNT(*) AS count
          FROM osm_feature
         WHERE region_code = #{regionCode}
         GROUP BY layer
    </select>

    <select id="countByRegion" resultType="com.aomap.ingest.domain.RegionCountRow">
        SELECT region_code, COUNT(*) AS count
          FROM osm_feature
         GROUP BY region_code
    </select>
</mapper>
